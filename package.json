{
  "name": "@yuksi/geo",
  "version": "0.8.0",
  "description": "Offline maps, door-level address search and route planning for React Native",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./core": {
      "types": "./lib/core/index.d.ts",
      "default": "./lib/core/index.js"
    },
    "./native": {
      "types": "./lib/native/index.d.ts",
      "default": "./lib/native/index.js"
    },
    "./app.plugin.cjs": "./app.plugin.cjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p example/tsconfig.check.json && tsc --noEmit -p example/tsconfig.react-test.json",
    "lint": "eslint .",
    "test": "jest",
    "verify": "npm run typecheck && npm run lint && jest --coverage",
    "mutation": "stryker run",
    "gates": "tsx gates/cli.ts",
    "try": "tsx scripts/try.ts",
    "device-report": "tsx scripts/device-report.ts",
    "device-run": "tsx scripts/device-run.ts",
    "serve:packs": "tsx scripts/serve-packs.ts",
    "serve:geo": "tsx scripts/serve-geo.ts",
    "build:server": "esbuild scripts/serve-geo.ts --bundle --platform=node --format=esm --target=node24 --external:node:* --outfile=dist/geo-server.mjs",
    "make:test-data": "tsx scripts/make-test-data.ts",
    "data:blocks": "tsx scripts/add-block-hashes.ts",
    "mlt:check": "tsx scripts/check-mlt-native.ts",
    "data:sources": "tsx scripts/fetch-sources.ts",
    "data:neighbourhoods": "tsx scripts/build-neighbourhoods.ts",
    "data:build": "tsx scripts/data-build.ts",
    "corrections": "tsx scripts/corrections.ts",
    "sim": "tsx scripts/sim.ts",
    "sdk-check": "tsx scripts/package-check.ts",
    "build-check": "tsx scripts/check-builds.ts",
    "data:release": "tsx scripts/data-release.ts",
    "data:publish": "tsx scripts/data-publish.ts",
    "golden:refresh": "tsx scripts/golden-refresh.ts",
    "icons:badges": "tsx scripts/make-badge-icons.ts",
    "icons:locate": "xcrun swiftc -O scripts/make-locate-icons.swift -o ${TMPDIR:-/tmp}/make-locate-icons -framework AppKit && ${TMPDIR:-/tmp}/make-locate-icons src/native/map/icons",
    "fonts": "node pipeline/tools/make-fonts.mjs",
    "icons:shields": "xcrun swiftc -O scripts/make-shield-icons.swift -o ${TMPDIR:-/tmp}/make-shield-icons -framework AppKit && ${TMPDIR:-/tmp}/make-shield-icons src/native/map/icons",
    "build:package": "tsx scripts/build-package.ts",
    "prepack": "npm run build:package",
    "prepare": "node -e \"process.exit(require('fs').existsSync('lib/index.js')?0:1)\" || npm run build:package",
    "weekly": "tsx scripts/weekly.ts",
    "weekly:simulate": "tsx scripts/weekly-simulate.ts",
    "monthly": "tsx scripts/monthly.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@mapbox/maki": "8.2.0",
    "@maplibre/maplibre-gl-style-spec": "^26.2.1",
    "@rapideditor/temaki": "5.13.0",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/jest-runner": "^10.0.0",
    "@swc/core": "^1.16.18",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/react-test-renderer": "^19.3.0",
    "eslint": "^9.39.5",
    "fast-check": "^4.10.2",
    "jest": "^30.5.2",
    "onnxruntime-node": "^1.31.1",
    "react-test-renderer": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0"
  },
  "dependencies": {
    "@noble/curves": "^1.9.7",
    "@noble/hashes": "^1.8.0",
    "@protomaps/basemaps": "5.7.2"
  },
  "files": [
    "lib",
    "app.plugin.cjs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "peerDependencies": {
    "@maplibre/maplibre-react-native": ">=11.5.0",
    "expo": ">=57.0.0",
    "expo-crypto": ">=57.0.0",
    "expo-file-system": ">=57.0.0",
    "expo-network": ">=57.0.0",
    "expo-sqlite": ">=57.0.0",
    "react": ">=19.0.0",
    "react-native": ">=0.86.0"
  },
  "sideEffects": false
}
