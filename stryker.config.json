{
  "mutate": [
    "src/core/**/*.ts",
    "!src/core/index.ts",
    "!src/core/text/index.ts"
  ],
  "testRunner": "jest",
  "jest": {
    "configFile": "jest.mutation.config.js"
  },
  "coverageAnalysis": "perTest",
  "thresholds": {
    "high": 90,
    "low": 80,
    "break": 80
  },
  "reporters": [
    "clear-text",
    "progress"
  ],
  "ignorePatterns": [
    "dist",
    "pipeline/.venv",
    "pipeline/bin",
    "pipeline/data",
    "pipeline/tests",
    "pipeline/extract",
    "example/ios",
    "example/android",
    "example/node_modules",
    "example/.expo"
  ],
  "dryRunTimeoutMinutes": 30,
  "concurrency": 10,
  "incremental": true
}
